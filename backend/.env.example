# 服务
NODE_ENV=development
PORT=3000

# 数据库
MONGODB_URI=mongodb://127.0.0.1:27017/bms

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d

# 文件上传
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=http://localhost:3000

# 微信小程序（如需启用 wechat 登录）
WX_APPID=
WX_SECRET=

# 默认管理员（首次启动自动创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_REALNAME=系统管理员
DEFAULT_ADMIN_PHONE=13800000000
